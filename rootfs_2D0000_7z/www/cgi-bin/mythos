#!/usr/bin/env ucode

'use strict';

import { stdin, stdout } from 'fs';

import request from 'luci.http';
import dispatch from 'mythos.dispatcher';

const input_bufsize = 4096;
let input_available = +getenv('CONTENT_LENGTH') || 0;

function read(len) {
	if (input_available == 0) {
		stdin.close();

		return null;
	}

	const chunk = stdin.read(min(input_available, len ?? input_bufsize, input_bufsize));

	if (chunk == null) {
		input_available = 0;
		stdin.close();
	} else {
		input_available -= length(chunk);
	}

	return chunk;
}

function write(data) {
	return stdout.write(data);
}

const req = request(getenv(), read, write);

try {
	dispatch(req);
} catch (e) {
	req.status(500);
}

req.close();
