setup_web() {
	logger -t mythos "Setup Web Interface"

	[ "$(uci -q get uhttpd.main.redirect_https)" != "0" ] && uci -q set uhttpd.main.redirect_https='0'
	[ "$(uci -q get uhttpd.defaults.key_type)" != "ec" ] && uci -q set uhttpd.defaults.key_type='ec'
	[ "$(uci -q get uhttpd.defaults.commonname)" != "mythos-router" ] && uci -q set uhttpd.defaults.commonname='mythos-router'

	local have_mapping=0

	visit_ucode_prefix() {
		local val="$1"

		if [ "$val" = "/cgi-bin/mythos=/usr/share/ucode/mythos/uhttpd.uc" ]
		then
			have_mapping=1
		fi
	}

	config_load uhttpd
	config_list_foreach main ucode_prefix visit_ucode_prefix

	if [ "$have_mapping" = "0" ]
	then
		uci -q add_list uhttpd.main.ucode_prefix='/cgi-bin/mythos=/usr/share/ucode/mythos/uhttpd.uc'
	fi

	uci -q commit uhttpd
}

setup_recovery_network() {
	logger -t mythos "Setup Recovery Network"

	# These must be updated together!
	local network_id='48d6023c46eba13a'
	local iface_name='ztosiothl4'

	# Get secret value for current authorization to recovery network
	local recovery_network_secret="$(uci -q get zerotier.global.secret)"

	# Get secret value from old location if none found
	if [ "${recovery_network_secret}" = "" ]
	then
		recovery_network_secret="$(uci -q get zerotier.mythos_recovery.secret)"
	fi

	# Remove sample ZeroTier config
	uci -q batch <<-EOI
		delete zerotier.global
		delete zerotier.earth
		delete zerotier.mynet
	EOI

	# Remove existing recovery network configuration
	uci -q batch <<-EOI
		delete firewall.recovery
		delete network.recovery
		delete zerotier.mythos_recovery
	EOI

	# Recreate recovery network configuration
	uci -q batch <<-EOI
		set firewall.recovery='zone'
		set firewall.recovery.name='recovery'
		set firewall.recovery.input='ACCEPT'
		set firewall.recovery.output='ACCEPT'
		set firewall.recovery.forward='REJECT'
		set firewall.recovery.mtu_fix='1'
		add_list firewall.recovery.network='recovery'
		set network.recovery='interface'
		set network.recovery.device='${iface_name}'
		set network.recovery.proto='none'
		set zerotier.global='zerotier'
		set zerotier.global.enabled='1'
		set zerotier.mythos_recovery='network'
		set zerotier.mythos_recovery.id='${network_id}'
	EOI

	# Restore secret value for recovery network, if present
	if [ "${recovery_network_secret}" != "" ]
	then
		uci -q batch <<-EOI
			set zerotier.global.secret='${recovery_network_secret}'
		EOI
	fi

	# Commit changes
	uci -q batch <<-EOI
		commit firewall
		commit network
		commit zerotier
	EOI
}

setup_system
setup_network
setup_ntp
setup_web
setup_recovery_network

exit 0
